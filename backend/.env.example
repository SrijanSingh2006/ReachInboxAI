PORT=5000

# Upstash Cloud Redis (Queue & Locks)
REDIS_HOST=your-redis-host.upstash.io
REDIS_PORT=6379
REDIS_PASSWORD=your_upstash_redis_password
REDIS_TLS=true

# Database (Supabase PostgreSQL / MySQL / SQLite)
DB_TYPE=postgres
DB_HOST=aws-0-ap-southeast-1.pooler.supabase.com
DB_PORT=5432
DB_USER=postgres.your_project_id
DB_PASS=your_database_password
DB_NAME=postgres
DB_SSL=true

# Elasticsearch (Optional)
ELASTICSEARCH_NODE=http://localhost:9200

# SMTP Delivery (Google Gmail SMTP or SendGrid)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_16_char_google_app_password

# Slack Alerts
SLACK_CLIENT_ID=your_slack_client_id
SLACK_CLIENT_SECRET=your_slack_client_secret
SLACK_REDIRECT_URI=http://localhost:5000/api/slack/oauth

# Rate Limiting & Concurrency Policies
MAX_EMAILS_PER_HOUR=200
MIN_DELAY_BETWEEN_EMAILS_MS=2000
WORKER_CONCURRENCY=5

# Frontend URL
FRONTEND_URL=http://localhost:3000
